# wBOB Bridge — environment variables
# Copy to .env and fill in real values. Never commit .env.
#
# Sections:
#   1. Deploy script (Foundry)  — used by forge script/Deploy.s.sol
#   2. Backend runtime          — read by backend/src/config.ts
#   3. Portal                   — see portal/.env.example

# ==============================================================================
# 1. DEPLOY SCRIPT (Foundry)
# ==============================================================================

# Gnosis RPC used by forge --rpc-url
RPC_URL=https://rpc.gnosischain.com

# EOA that pays gas for the deploy transaction (needs xDAI)
DEPLOYER_PRIVATE_KEY=0x...

# Gnosis Safe that will own DEFAULT_ADMIN_ROLE on WBob + BridgeController
SAFE_ADDRESS=0x...

# The five independent watcher EOA *addresses* (public — safe to commit once known)
WATCHER_1=0x...
WATCHER_2=0x...
WATCHER_3=0x...
WATCHER_4=0x...
WATCHER_5=0x...

# EOA address passed to Deploy.s.sol as the BridgeExecutorModule operator
# (same address as EXECUTOR_PRIVATE_KEY below, just the public address)
EXECUTOR_ADDRESS=0x...

# wBOB token parameters
MAX_SUPPLY_BOB=21000000
DAILY_LIMIT_BOB=1000000

# ==============================================================================
# 2. BACKEND RUNTIME
# ==============================================================================

# ── Required ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://bridge:password@localhost:5432/wbob_bridge

# Gnosis RPC (note: different var name from the deploy-script RPC_URL above)
GNOSIS_RPC_URL=https://rpc.gnosischain.com

# Deployed contract addresses — leave blank until after `forge script Deploy.s.sol`
BRIDGE_CONTROLLER_ADDRESS=
WBOB_ADDRESS=

# EOA private key — pays xDAI gas for executeMint calls. NOT the Safe. NOT the deployer.
EXECUTOR_PRIVATE_KEY=0x...

# Dobbscoin node RPC
DOBBSCOIN_RPC_URL=http://localhost:8332
DOBBSCOIN_RPC_USER=rpcuser
DOBBSCOIN_RPC_PASS=rpcpass

# HD wallet — most sensitive secrets in the bridge.
# xpub is used for deposit address derivation (read-only, safer).
# xpriv is used to sign Dobbscoin payout transactions.
# Use a HSM in production; never commit real values.
HD_WALLET_XPUB=xpub...
HD_WALLET_XPRIV=xprv...

# ── Optional (defaults shown) ─────────────────────────────────────────────────

PORT=3000
DOBBSCOIN_NETWORK=mainnet                 # mainnet | testnet
DOBBSCOIN_ADDRESS_VERSION=0               # 0x00 = Bitcoin/Dobbscoin mainnet P2PKH
DOBBSCOIN_FEE_RATE_SAT_PER_VBYTE=10
HD_DERIVATION_PATH=m/0
HD_CHANGE_PATH=m/1
MINT_DEADLINE_SECONDS=3600
EXECUTOR_POLL_INTERVAL_MS=15000
GNOSIS_CONFIRMATION_DEPTH=12

# Phase 6 — BridgeExecutorModule: enables emergency pause without a full Safe
# multisig round-trip. Leave blank to disable; fill in after deploy + enableModule.
BRIDGE_EXECUTOR_MODULE_ADDRESS=

# Phase 8 — Solvency monitor
MONITOR_INTERVAL_MS=300000            # how often to check (ms); default 5 min
ALERT_WEBHOOK_URL=                    # HTTP POST target for alerts; omit = log-only
ALERT_COOLDOWN_MS=3600000             # min interval between repeated alerts (ms); default 1 hr
LOW_UTXO_THRESHOLD_SAT=100000000     # warn when UTXO pool drops below this (sats); default 1 BOB
STUCK_ORDER_THRESHOLD_HOURS=4        # flag orders with no state change in this many hours
