# wBOB Bridge — public-facing nginx vhost for https://bridge.subgenius.finance
#
# Routes:
#   /v1/*  →  Fastify backend on 127.0.0.1:13013
#   /      →  Next.js portal on 127.0.0.1:8888
#
# Both upstreams are local. TLS cert managed by certbot's renewal timer.

server {
    listen 80;
    listen [::]:80;
    server_name bridge.subgenius.finance;

    # Redirect all plain HTTP to HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bridge.subgenius.finance;

    access_log /var/log/nginx/bridge.subgenius.finance.access.log;
    error_log  /var/log/nginx/bridge.subgenius.finance.error.log;

    ssl_certificate     /etc/letsencrypt/live/bridge.subgenius.finance/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bridge.subgenius.finance/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 1m;

    # Backend API — preserve the /v1 prefix so Fastify's routes match.
    location /v1/ {
        proxy_pass http://127.0.0.1:13013;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Legacy /health (pre-v1). Forward to backend.
    location = /health {
        proxy_pass http://127.0.0.1:13013;
        proxy_set_header Host $host;
    }

    # Everything else → Next.js portal (dev server on :8888).
    # Upgrade headers let Next's HMR websocket survive the proxy.
    location / {
        proxy_pass http://127.0.0.1:8888;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
    }
}
